{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "Animation and rendering library",
  "authors": [
    "ArcAnc"
  ],
  "license": "${mod_license}",
  "icon": "logo.png",
  "environment": "*",
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "fabric-api": "*",
    "minecraft": "${minecraft_version}",
    "java": ">=25"
  },
  "accessWidener": "pulselib.accesswidener",
  "entrypoints": {
    "main": [
      "com.arcanc.pulselib.fabric.PulseLibFabric"
    ],
    "client": [
      "com.arcanc.pulselib.fabric.PulseLibFabricClient"
    ]
  },
  "mixins": [
    {
      "config": "pulselib.mixins.json",
      "environment": "client"
    }
  ]
}
